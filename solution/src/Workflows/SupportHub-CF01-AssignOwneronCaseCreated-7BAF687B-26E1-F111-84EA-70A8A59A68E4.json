              },
              "type": "Query",
              "inputs": {
                "from": "@result('Scope_-_Try')",
                "where": "@equals(item()?['status'], 'Failed')"
              }
            },
            "Compose_-_Error_Details": {
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "93c81dca-2e4d-484f-9a28-d1e8ff8074c4"
              },
              "type": "Compose",
              "inputs": "Failed Action@{first(body('Filter_array'))?['name']}, Error Message@{first(body('Filter_array'))?['error']?['message']}, Failed Action@{first(body('Filter_array'))?['name']}"
            },
            "Add_a_new_row": {
              "runAfter": {
                "Compose_-_Error_Details": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "a8bc0be3-d09b-4c6f-963e-d49ced1ad0fc"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "sh_flowerrorlogs",
                  "item/sh_errormessage": "@outputs('Compose_-_Error_Details')",
                  "item/sh_name": "@workflow()?['tags']?['flowDisplayName']",
                  "item/sh_runurl": "@concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'],'/flows/', workflow()?['name'],'/runs/', workflow()?['run']?['name'])",
                  "item/utcconversiontimezonecode": "@utcNow()"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Terminate": {
              "runAfter": {
                "Add_a_new_row": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "2aa2b274-ff25-4d1e-b4e5-26c6f228ac43"
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "500",
                  "message": "@{outputs('Compose_-_Error_Details')}"
                }
              }
            }
          },
          "runAfter": {
            "Scope_-_Try": [
