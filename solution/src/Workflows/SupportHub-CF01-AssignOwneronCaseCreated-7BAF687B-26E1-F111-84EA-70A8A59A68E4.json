                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              },
              "expression": "@triggerOutputs()?['body/sh_priority']",
              "metadata": {
                "operationMetadataId": "2f31c402-6db6-4d63-acd1-d81e0d655903"
              },
              "type": "Switch"
            }
          },
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "56603cad-baaf-4ad2-972b-4e62b24c5892"
          },
          "type": "Scope",
          "description": "Wraps the core product lookup and priority based owner assignment logic so any runtime failures are captured for error handling."
        },
